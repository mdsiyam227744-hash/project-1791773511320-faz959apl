# ============================================================================
# Environment configuration template.
#
# NEXT_PUBLIC_* variables are safe to expose to the browser.
# All other variables are server-only and must never be exposed.
# Values are provisioned through the platform environment — never commit real
# secrets to the repository or paste them into chat.
# ============================================================================

# Public URL of this application (used for metadata, links, webhooks).
NEXT_PUBLIC_APP_URL=https://example.com

# --- Supabase (project database + authentication) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Flight data provider (optional; Amadeus Self-Service) ------------------
# When absent, the route planner shows "Live fare unavailable — request a quote."
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com

# --- Payments (optional; Stripe) -------------------------------------------
# When absent, paid services stay disabled and the webhook endpoint returns 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Outbound email (optional; Resend) -------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
